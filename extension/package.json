{
  "name": "extension",
  "displayName": "Extension",
  "version": "0.0.1",
  "description": "an extension made to keep track on manga/manwha/manhua that your currently reading ",
  "author": "bradley andrews",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@clerk/chrome-extension": "2.5.21",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.3.3"
  },
  "manifest": {
    "key": "$CRX_PUBLIC_KEY",
    "permissions": ["cookies", "storage", "contextMenus", "tabs", "activeTab"],
    "host_permissions": [
      "$PLASMO_PUBLIC_CLERK_SYNC_HOST/*",
      "$CLERK_FRONTEND_API/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/auth.html"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],
    "icons": {
      "16": "./gen-assets/icon16.plasmo.png",
      "32": "./gen-assets/icon32.plasmo.png",
      "48": "./gen-assets/icon48.plasmo.png",
      "128": "./gen-assets/icon128.plasmo.png"
    },
    "action": {
      "default_popup": "popup.html",
      "default_title": "Kollect: Manga Tracker",
      "default_icon": {
        "16": "./gen-assets/icon16.plasmo.png",
        "32": "./gen-assets/icon32.plasmo.png"
      }
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "bradley-kollect@addons.mozilla.org",
        "data_collection_permissions": {
          "required": [
            "none"
          ],
          "optional": []
        }
      }
    }
  }
}